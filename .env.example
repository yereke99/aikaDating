APP_ENV=development
PORT=8080

# SQLite file. The application creates the directory and applies the one users-table migration.
DATABASE_PATH=./data/aikabot.db
PROFILE_PHOTO_DIR=./profile_photo

BOT_TOKEN=replace_with_botfather_token
BOT_USERNAME=your_aikabot_username
MINI_APP_URL=https://app.example.com
MINI_APP_ORIGIN=https://app.example.com
ADMIN_TELEGRAM_IDS=123456789

AUTH_MAX_AGE=24h
LIKE_RATE_PER_MINUTE=5
# Per-target cooldown shared by the like and message actions (each action has its own timer).
ACTION_COOLDOWN=30m
MAX_PROFILE_PHOTOS=4
WEB_DIR=./web/dist

# --- one-to-one video calls -------------------------------------------------------------------
# Media is peer-to-peer; the server only relays signalling and never sees audio or video.
CALLS_ENABLED=true
# An unanswered invitation is cancelled after this.
CALL_INVITE_TIMEOUT=45s
# A call that was accepted but never connected is given up on after this.
CALL_SETUP_TIMEOUT=60s
# How long an idle signalling request is held open. It returns immediately when an event arrives,
# so this is the idle ceiling, not the latency.
CALL_EVENT_WAIT=20s
# A participant that stops polling for this long is treated as gone. Must exceed CALL_EVENT_WAIT.
CALL_PRESENCE_TIMEOUT=45s

# STUN lets both phones find their public address and connect directly, which is the low-latency
# path this feature is built around.
STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302
# TURN is the relay fallback for networks where a direct path is impossible: symmetric and
# carrier-grade NAT, many corporate and hotel networks. Without it those calls simply fail.
# Credentials are handed out per authenticated request and never appear in the frontend bundle.
TURN_URLS=
# Preferred: coturn `use-auth-secret`, which mints an expiring credential per request.
TURN_STATIC_AUTH_SECRET=
TURN_CREDENTIAL_TTL=1h
# Alternative to the secret above: one long-lived TURN account.
TURN_USERNAME=
TURN_PASSWORD=

# Local browser development only. This mode is rejected when APP_ENV=production.
LOCAL_DEV=false
DEV_TELEGRAM_USER_ID=123456789
DEV_TELEGRAM_FIRST_NAME=Local
DEV_TELEGRAM_LAST_NAME=Developer
DEV_TELEGRAM_USERNAME=local_developer
DEV_TELEGRAM_LANGUAGE_CODE=en
